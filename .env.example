# Application
NODE_ENV=development
PORT=3000

# Database (local dev — connects via port mapping 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=mms
DB_PASSWORD=mms_secret
DB_NAME=mms_db

# Database (Docker internal — containers talk on 5432)
# DB_HOST=postgres
# DB_PORT=5432

# docker compose: host port for the postgres container (default 5433).
# Change it when a local PostgreSQL already listens on 5433, then use the
# same value for DB_PORT above.
# POSTGRES_HOST_PORT=5433

# docker compose: the `edge` network nginx, the backend and the frontend share. nginx gets
# the pinned address and the backend trusts X-Forwarded-For from that address only
# (TRUST_PROXY); other containers get addresses from the dynamic range, which must lie in
# the subnet and exclude the pinned address. Change all three together when the subnet
# collides with a network on the host (VPN, other Docker networks).
# MMS_EDGE_SUBNET=10.87.64.0/24
# MMS_EDGE_DYNAMIC_RANGE=10.87.64.128/25
# MMS_NGINX_EDGE_ADDRESS=10.87.64.10

# Multi-tenancy (see Web/backend/docs/tenancy.md)
# TENANCY_MODE: legacy | enforced. Default legacy: one tenant, the database as before; use
# this for every real deployment until milestone M1. enforced binds every connection to the
# tenant of the request (Row-Level Security) and signs in with a tenant code. Any other
# value fails startup.
# Under enforced the application must connect as the role `mms_app` (NOSUPERUSER
# NOBYPASSRLS): DB_USER=mms above is REFUSED at boot. Provision it once per cluster, after
# the migrations ran and as a superuser:
#   ALTER ROLE mms_app LOGIN PASSWORD '<secret>';
# then set DB_USER=mms_app and DB_PASSWORD=<secret>, and keep the migrations on the owner
# with DATABASE_URL=postgres://<owner>:<password>@<host>:<port>/<db> (the migrator reads
# it; the application ignores it). The database must also have lost its legacy tenant
# default (ALTER DATABASE <db> RESET app.tenant_id), or startup is refused. Run that reset
# only after EVERY replica runs enforced: afterwards a legacy replica sees no rows, and
# legacy mode itself refuses to start.
# Under legacy the database user must be a superuser, a BYPASSRLS role or mms_app
# (DB_USER=mms is a superuser, so it works), and the database must still carry the default
# that migration 037 sets: back up with pg_dump --create, or startup is refused.
# Shipped clients send no tenant code until M1c; until then enforced needs LEGACY_DEFAULT_TENANT_CODE.
# TENANCY_MODE=legacy
# LEGACY_DEFAULT_TENANT_CODE: TENANCY_MODE=enforced only. A sign-in that sends no tenantCode
# (a client released before the tenant-code screen) signs in to this tenant, with a warning
# in the log per sign-in. Transitional: remove it in the release after M1c (the clients with
# the tenant-code screen) ships. Unset: such a sign-in is a 400 tenant_code_required. A code that names
# no active tenant, or a malformed one, refuses boot (checked in every mode).
# LEGACY_DEFAULT_TENANT_CODE=phu-dinh

# Migrations (npm run db:migrate; the Docker image migrates before the server starts).
# See Web/backend/docs/migrations.md.
# Longest one statement waits for a table lock (default 10s)
# MIGRATION_LOCK_TIMEOUT=10s
# Longest to wait for another running migrator (default 10min)
# MIGRATION_LOCK_WAIT=10min
# Only to adopt a database migrated before migration history existed (tables but no
# schema_migrations rows; the migrator refuses to start and names this setting). Back
# the database up, set it to the exact name of the last migration file already applied,
# such as 018_recruitment_applications.sql, run the migrator once, then remove it.
# MIGRATION_BASELINE_THROUGH=

# Redis: Socket.IO fan-out and shared rate-limit counters (sign-in lockout counters live in Postgres)
# REDIS_HOST: Redis server hostname
REDIS_HOST=localhost
# REDIS_PORT: Redis server port (1-65535)
REDIS_PORT=6379
# REDIS_PASSWORD: the server's requirepass; empty when it has none
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=change_refresh_me_in_production_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# MFA: 64 hex chars (32 bytes) encrypting TOTP secrets at rest — `openssl rand -hex 32`.
# Required when NODE_ENV=production; development derives one from JWT_SECRET.
# Changing it makes every enrolled authenticator unusable (reset MFA for those users).
MFA_ENCRYPTION_KEY=

# TRUST_PROXY: reverse proxies whose X-Forwarded-For names the client for rate limits,
# sessions and audit rows. true | false | a hop count | a comma-separated list of IPs,
# CIDRs, loopback, linklocal, uniquelocal; anything else fails startup. Required when
# NODE_ENV=production (false = clients connect directly). Empty: no proxy (local dev).
TRUST_PROXY=

# THROTTLE_STORAGE: where rate-limit counters live. redis = shared by every instance
# (default when NODE_ENV=production; startup fails if Redis is unusable); memory = per
# instance (default otherwise; only correct for a single instance).
# THROTTLE_STORAGE=memory
# THROTTLE_KEY_PREFIX: prefix of the rate-limit keys in Redis (default mms:throttle:)
# THROTTLE_KEY_PREFIX=mms:throttle:

# SOCKET_ADAPTER: how Socket.IO events reach clients. redis = through Redis pub/sub, so
# clients of every instance receive every event (default when NODE_ENV=production;
# startup fails if Redis is unusable); memory = only clients of the emitting instance
# (default otherwise; only correct for a single instance).
# SOCKET_ADAPTER=memory

# Per-client rate limits for sign-in (defaults: 5 per 300000 ms) and MFA codes
# (defaults: 10 per 60000 ms)
# THROTTLE_LOGIN_LIMIT=5
# THROTTLE_LOGIN_TTL_MS=300000
# THROTTLE_MFA_LIMIT=10
# THROTTLE_MFA_TTL_MS=60000
