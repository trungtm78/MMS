# Application
NODE_ENV=development
PORT=3000

# Database (local dev — connects via port mapping 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=mms
DB_PASSWORD=mms_secret
DB_NAME=mms_db

# Database (Docker internal — containers talk on 5432)
# DB_HOST=postgres
# DB_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change_me_in_production_min_32_chars
JWT_REFRESH_SECRET=change_refresh_me_in_production_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
