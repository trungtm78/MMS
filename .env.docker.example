# Copy to .env.docker (gitignored) before `docker compose up`.
# The backend container reads this file; services reach each other by name.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1/mms_core

# Database (compose service `postgres`; must match its POSTGRES_* settings)
DB_HOST=postgres
DB_PORT=5432
DB_USER=mms
DB_PASSWORD=mms_secret
DB_NAME=mms_db

# Migrations: the backend applies pending migrations before it starts (see
# Web/backend/docs/migrations.md). Set false when a separate release step migrates.
# Releases with incompatible schema changes are deployed drained: stop every old
# instance, migrate with one instance, then start the new version.
# RUN_MIGRATIONS=true
# Longest one statement waits for a table lock (default 10s)
# MIGRATION_LOCK_TIMEOUT=10s
# Longest to wait for another running migrator (default 10min)
# MIGRATION_LOCK_WAIT=10min
# Only to adopt a database migrated before migration history existed (tables but no
# schema_migrations rows; the backend refuses to start and names this setting). Back
# the database up, set it to the exact name of the last migration file already applied,
# such as 018_recruitment_applications.sql, start one instance once, then remove it.
# MIGRATION_BASELINE_THROUGH=

# Redis (compose service `redis`): Socket.IO fan-out and shared rate-limit counters
# (sign-in lockout counters live in Postgres).
# The compose files pin REDIS_HOST/REDIS_PORT, and docker-compose.prod.yml also passes
# REDIS_PASSWORD from the root .env, so the backend matches the redis service.
# REDIS_HOST: Redis server hostname
REDIS_HOST=redis
# REDIS_PORT: Redis server port (1-65535)
REDIS_PORT=6379
# REDIS_PASSWORD: the server's requirepass; empty for the development compose file
REDIS_PASSWORD=

# JWT — generate real secrets, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_min_32_chars_random_hex
JWT_REFRESH_SECRET=change_me_too_min_32_chars_random
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# 64 hex chars (32 bytes) used to encrypt CCCD numbers at rest
AES_CCCD_KEY=

# 64 hex chars (32 bytes) used to encrypt MFA (TOTP) secrets at rest — `openssl rand -hex 32`.
# Required when NODE_ENV=production. Changing it invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=

# TRUST_PROXY: reverse proxies whose X-Forwarded-For names the client for rate limits,
# sessions and audit rows. Both compose files override it with nginx's pinned address on
# the `edge` network (MMS_NGINX_EDGE_ADDRESS in the root .env), the only proxy that
# overwrites that header. Required when NODE_ENV=production; true | false | hop count |
# list of IPs, CIDRs, loopback, linklocal, uniquelocal. If another proxy sits in front of
# nginx, change nginx/conf.d/mms.conf too.
TRUST_PROXY=10.87.64.10

# THROTTLE_STORAGE: where rate-limit counters live. redis = shared by every replica
# (default when NODE_ENV=production, pinned by docker-compose.prod.yml; startup fails if
# Redis is unusable); memory = per replica (default otherwise; single instance only).
# THROTTLE_STORAGE=redis
# THROTTLE_KEY_PREFIX: prefix of the rate-limit keys in Redis (default mms:throttle:)
# THROTTLE_KEY_PREFIX=mms:throttle:

# SOCKET_ADAPTER: how Socket.IO events reach clients. redis = through Redis pub/sub, so
# clients of every replica receive every event (default when NODE_ENV=production, pinned
# by docker-compose.prod.yml; startup fails if Redis is unusable); memory = only clients of
# the emitting replica (default otherwise; single instance only).
# SOCKET_ADAPTER=redis

# Per-client rate limits (defaults shown)
# THROTTLE_LOGIN_LIMIT=5
# THROTTLE_LOGIN_TTL_MS=300000
# THROTTLE_MFA_LIMIT=10
# THROTTLE_MFA_TTL_MS=60000

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost,http://localhost:5173
