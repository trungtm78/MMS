{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/support/utc-timezone.global-setup.ts",
  "globalTeardown": "<rootDir>/support/e2e-roles.global-teardown.ts",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.js$": ["ts-jest", { "useESM": false }]
  },
  "transformIgnorePatterns": ["/node_modules/(?!(otplib|@otplib|@scure|@noble))"]
}
